# Dolibarr ERP
DOLIBARR_API_URL=https://bollente.uz/api/index.php/
DOLIBARR_API_KEY=your_dolibarr_api_key_here

# Database
DB_PASSWORD=srlux_secure_password_change_me

# Admin API key (защита /api/admin/*)
ADMIN_API_KEY=srlux_admin_secret_key_change_me

# Telegram уведомления о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Курс конвертации USD → UZS (если нет динамического)
USD_TO_UZS_RATE=12650

# Backend URL для скрипта синхронизации
BACKEND_URL=http://api:8000

# Environment
ENVIRONMENT=production
